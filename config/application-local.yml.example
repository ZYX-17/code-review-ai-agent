# ============================================
# 本地开发配置模板
#
# 使用方式：
#   cp config/application-local.yml.example \
#      config/application-local.yml
#
# application-local.yml 已被 .gitignore 忽略，可以放心填写真实密码。
# 默认激活的 profile 是 local；生产环境使用 prod。
# ============================================

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/code_guardian
    username: postgres
    password: postgres

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

  data:
    redis:
      host: localhost
      port: 6379
      password: ""
      database: 1

  ai:
    openai:
      api-key: ""
      base-url: https://api.openai.com
    qwen:
      # Qwen 对话模型（可选，与向量检索的 embedding Key 分开）
      api-key: ""
      base-url: https://dashscope.aliyuncs.com/compatible-mode
    ollama:
      base-url: http://localhost:11434

minio:
  endpoint: http://localhost:9000
  access-key: minioadmin
  secret-key: minioadmin

gitcode:
  api:
    token: ""

logging:
  level:
    com.codeguardian: DEBUG

# 外部集成（CI/CD、Webhook）共享令牌；不需要外部集成时留空。
# CI/CD 请求头 X-API-Token，GitLab/GitCode Webhook Secret 使用同一个值。
app:
  rag:
    # 配置 embedding Key 后，启动时为已有文档生成向量
    vectorize-on-startup: true
    embedding:
      # 留空时复用 spring.ai.qwen.api-key；也可以单独填 embedding Key
      api-key: ""
      base-url: https://dashscope.aliyuncs.com/compatible-mode
      model: text-embedding-v3
      dimensions: 1024
  integration:
    api-token: ""
