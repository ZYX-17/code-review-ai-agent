# ===== 镜像 =====
# 手动部署时可指定 tag；CI/CD 会自动注入 sha-<commit> 标签
APP_IMAGE=ghcr.io/zyx-17/code-review-ai-agent:latest
APP_PORT=7003

# ===== PostgreSQL =====
DB_PASSWORD=change-me

# ===== Redis =====
REDIS_PASSWORD=change-me

# ===== MinIO =====
MINIO_ACCESS_KEY=codeguardian
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=code-review

# ===== AI 模型（至少配置一个） =====
QWEN_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# ===== 向量检索（可选，独立于对话模型 Key） =====
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIMENSIONS=1024

# ===== 可选 =====
GITCODE_TOKEN=

# ===== 外部集成（CI/CD、Webhook） =====
# CI/CD 请求头 X-API-Token；GitLab/GitCode Webhook Secret 使用同一个值
# 留空时外部集成接口会拒绝所有请求
API_TOKEN=change-me

# ===== JVM =====
JAVA_OPTS="-Xms512m -Xmx2g"
